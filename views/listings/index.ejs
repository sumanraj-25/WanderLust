<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
            padding: 0.75rem 0;
            border-bottom: 1px solid #eee;
        }
        
        #filters::-webkit-scrollbar {
            display: none;
        }
        
        .filter {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            min-width: 85px;
            flex-shrink: 0;
            padding: 0.5rem 0.25rem;
            color: #717171;
            text-decoration: none;
            border-bottom: 2px solid transparent;
            opacity: 0.8;
            transition: opacity 0.2s, border-color 0.2s;
        }
        
        .filter i {
            font-size: 1.25rem;
        }
        
        .filter p {
            margin: 0;
            font-size: 0.8rem;
            white-space: nowrap;
        }
        
        .filter:hover,
        .filter.active {
            color: #222;
            opacity: 1;
            border-bottom-color: #222;
        }
        
        .tax-toggle {
            margin-left: auto;
            flex-shrink: 0;
            white-space: nowrap;
            border: 1px solid #ccc;
            border-radius: 1rem;
            padding: 0.8rem 1rem;
        }
        
        .tax-info {
            display: none;
        }
        
        .results-heading {
            margin: 1.25rem 0 0.5rem;
            font-size: 1.1rem;
        }
        
        .listing-card {
            border: none !important;
            margin-bottom: 2rem;
        }
        
        .listing-link {
            color: inherit;
            text-decoration: none;
        }
        
        .listing-card img {
            height: 20rem;
            object-fit: cover;
            border-radius: 1rem;
        }
        
        .listing-card:hover img {
            opacity: 0.92;
        }
        
        .no-results {
            padding: 3rem 1rem;
            text-align: center;
        }
        
        @media (max-width: 768px) {
            #filters {
                gap: 0.75rem;
            }
            .filter {
                min-width: 75px;
            }
            .tax-toggle {
                margin-left: 0;
            }
        }
    </style>

    <%
    const searchValue = typeof search !== "undefined" ? search : "";
    const activeCategory = typeof selectedCategory !== "undefined"
        ? selectedCategory
        : "";

    const categoryOptions = [
        { name: "Trending", slug: "trending", icon: "fa-fire" },
        { name: "Rooms", slug: "rooms", icon: "fa-bed" },
        { name: "Iconic cities", slug: "iconic-cities", icon: "fa-mountain-city" },
        { name: "Mountains", slug: "mountains", icon: "fa-mountain" },
        { name: "Castles", slug: "castles", icon: "fa-chess-rook" },
        { name: "Amazing pools", slug: "amazing-pools", icon: "fa-person-swimming" },
        { name: "Camping", slug: "camping", icon: "fa-campground" },
        { name: "Farms", slug: "farms", icon: "fa-tractor" },
        { name: "Arctic", slug: "arctic", icon: "fa-snowflake" },
        { name: "Deserts", slug: "deserts", icon: "fa-sun" }
    ];
%>

        <div id="filters">
            <% for (const item of categoryOptions) { %>
                <a class="filter <%= activeCategory === item.slug ? 'active' : '' %>" href="/listings?category=<%= item.slug %><%= searchValue ? '&search=' + encodeURIComponent(searchValue) : '' %>" aria-label="Show <%= item.name %> listings">

            <i class="fa-solid <%= item.icon %>"></i>
            <p><%= item.name %></p>
        </a>
                <% } %>

                    <div class="tax-toggle">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">

                            <label class="form-check-label" for="flexSwitchCheckDefault">
                Display total after taxes
            </label>
                        </div>
                    </div>
        </div>

        <% if (searchValue || activeCategory) { %>
            <div class="results-heading">
                <strong>
            <% if (searchValue) { %>
                Results for "<%= searchValue %>"
            <% } %>

            <% if (searchValue && activeCategory && activeCategory !== "trending") { %>
                ·
            <% } %>

            <% if (activeCategory && activeCategory !== "trending") { %>
                <%= categoryOptions.find(item => item.slug === activeCategory)?.name || activeCategory %>
            <% } %>
        </strong>

                <a class="btn btn-sm btn-outline-secondary ms-2" href="/listings">
            Clear filters
        </a>
            </div>
            <% } %>

                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 mt-3">
                    <% if (allListings.length === 0) { %>
                        <div class="col-12 no-results">
                            <h4>No matching stays found</h4>
                            <p>Try another destination or choose a different category.</p>
                            <a href="/listings" class="btn btn-outline-dark">
                View all listings
            </a>
                        </div>
                        <% } else { %>

                            <% for (const listing of allListings) { %>
                                <div class="col">
                                    <a href="/listings/<%= listing._id %>" class="listing-link">
                                        <div class="card listing-card">
                                            <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85' %>" class="card-img-top" alt="<%= listing.title %>">

                                            <div class="card-body pt-2">
                                                <p class="card-text">
                                                    <b><%= listing.title %></b>
                                                    <br> &#8377;
                                                    <%= Number(listing.price || 0).toLocaleString("en-IN") %>
                                                        / night
                                                        <i class="tax-info">
                                    &nbsp; +18% GST
                                </i>
                                                </p>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <% } %>

                                    <% } %>
                </div>

                <script>
                    const taxSwitch = document.getElementById("flexSwitchCheckDefault");
                    const taxInfo = document.querySelectorAll(".tax-info");

                    taxSwitch.addEventListener("change", () => {
                        taxInfo.forEach((info) => {
                            info.style.display = taxSwitch.checked ? "inline" : "none";
                        });
                    });
                </script>