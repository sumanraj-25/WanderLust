<style>
    .search-btn {
        background-color: #fe424d;
        color: #fff;
        border-radius: 25px;
        padding: 0.5rem 1rem;
        white-space: nowrap;
        border: none;
    }
    
    .search-btn:hover {
        background-color: #e93642;
        color: #fff;
    }
    
    .search-btn i {
        margin-right: 0.5rem;
    }
    
    .search-inp {
        border-radius: 25px;
        padding: 0.5rem 1.25rem;
        min-width: 0;
        width: 250px;
        max-width: 100%;
    }
    /* Search dropdown */
    
    .search-wrapper {
        position: relative;
    }
    
    .search-suggestions {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        width: 100%;
        min-width: 250px;
        max-height: 260px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
        z-index: 2000;
    }
    
    .search-suggestions.show {
        display: block;
    }
    
    .search-suggestion {
        display: block;
        width: 100%;
        padding: 12px 16px;
        border: none;
        background: #fff;
        color: #222;
        text-align: left;
        cursor: pointer;
    }
    
    .search-suggestion:hover,
    .search-suggestion:focus {
        background-color: #f5f5f5;
        outline: none;
    }
    
    .search-suggestion i {
        margin-right: 10px;
        color: #777;
    }
    
    .no-suggestions {
        padding: 12px 16px;
        color: #777;
        font-size: 0.9rem;
    }
    
    @media (max-width: 767px) {
        .search-form {
            margin: 0.75rem 0;
            width: 100%;
        }
        .search-wrapper {
            flex: 1;
            min-width: 0;
        }
        .search-inp {
            width: 100%;
        }
        .search-suggestions {
            min-width: 100%;
        }
    }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">

        <!-- Brand -->
        <a class="navbar-brand" href="/listings">
            <i class="fa-regular fa-compass"></i>
        </a>

        <!-- Mobile toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

            <!-- Explore -->
            <div class="navbar-nav">
                <a class="nav-link" href="/listings">Explore</a>
            </div>

            <!-- Destination search -->
            <div class="navbar-nav ms-auto">
                <form class="d-flex search-form" role="search" action="/listings" method="GET" autocomplete="off" id="destinationSearchForm">
                    <div class="search-wrapper">
                        <input class="form-control search-inp" type="search" id="destinationSearch" name="search" placeholder="Search destinations" aria-label="Search destinations" aria-autocomplete="list" aria-controls="searchSuggestions" aria-expanded="false" value="<%= typeof search !== 'undefined' ? search : '' %>">

                        <div class="search-suggestions" id="searchSuggestions" role="listbox"></div>
                    </div>

                    <button class="btn search-btn ms-2" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search
                    </button>
                </form>
            </div>

            <!-- User links -->
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/listings/new">
                    Airbnb your home
                </a>

                <% if (!currUser) { %>
                    <a class="nav-link" href="/signup">
                        <b>Sign up</b>
                    </a>
                    <a class="nav-link" href="/login">
                        <b>Log in</b>
                    </a>
                    <% } else { %>
                        <a class="nav-link" href="/logout">
                            <b>Log out</b>
                        </a>
                        <% } %>
            </div>

        </div>
    </div>
</nav>

<script>
    (() => {
        const input = document.getElementById("destinationSearch");
        const suggestions = document.getElementById("searchSuggestions");
        const form = document.getElementById("destinationSearchForm");

        if (!input || !suggestions || !form) return;

        // Example destinations shown in the dropdown.
        // You can add more destinations to this list.
        const destinations = [
            "Bengaluru",
            "Mumbai",
            "Delhi",
            "Goa",
            "Jaipur",
            "Manali",
            "Shimla",
            "Hyderabad",
            "Chennai",
            "Kolkata",
            "Pune",
            "Udaipur",
            "Ooty",
            "Mysuru",
            "Coorg",
            "Darjeeling",
            "Rishikesh",
            "Varanasi",
            "Agra",
            "Srinagar"
        ];

        function closeSuggestions() {
            suggestions.classList.remove("show");
            input.setAttribute("aria-expanded", "false");
        }

        function showSuggestions() {
            suggestions.classList.add("show");
            input.setAttribute("aria-expanded", "true");
        }

        function selectDestination(destination) {
            input.value = destination;
            closeSuggestions();
            form.requestSubmit();
        }

        function renderSuggestions(query) {
            suggestions.innerHTML = "";

            if (!query) {
                closeSuggestions();
                return;
            }

            const matches = destinations.filter(destination =>
                destination.toLowerCase().includes(query.toLowerCase())
            );

            if (matches.length === 0) {
                const message = document.createElement("div");
                message.className = "no-suggestions";
                message.textContent = "No matching destinations";
                suggestions.appendChild(message);
                showSuggestions();
                return;
            }

            matches.slice(0, 7).forEach(destination => {
                const option = document.createElement("button");

                option.type = "button";
                option.className = "search-suggestion";
                option.setAttribute("role", "option");

                const icon = document.createElement("i");
                icon.className = "fa-solid fa-location-dot";

                const label = document.createElement("span");
                label.textContent = destination;

                option.appendChild(icon);
                option.appendChild(label);

                option.addEventListener("click", () => {
                    selectDestination(destination);
                });

                suggestions.appendChild(option);
            });

            showSuggestions();
        }

        input.addEventListener("input", () => {
            renderSuggestions(input.value.trim());
        });

        input.addEventListener("focus", () => {
            if (input.value.trim()) {
                renderSuggestions(input.value.trim());
            }
        });

        input.addEventListener("keydown", event => {
            if (event.key === "Escape") {
                closeSuggestions();
            }

            if (event.key === "ArrowDown") {
                const firstOption = suggestions.querySelector(
                    ".search-suggestion"
                );

                if (firstOption) {
                    event.preventDefault();
                    firstOption.focus();
                }
            }
        });

        document.addEventListener("click", event => {
            if (!form.contains(event.target)) {
                closeSuggestions();
            }
        });
    })();
</script>